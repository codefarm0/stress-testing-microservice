[mysqld]
# Sized for a 1 GB container. Known, fixed DB capacity = clean experiment.
innodb_buffer_pool_size        = 512M
innodb_redo_log_capacity       = 512M
innodb_flush_log_at_trx_commit = 1          # durable commits: every order is an fsync (realistic)
max_connections                = 300
innodb_lock_wait_timeout       = 10         # waiting >10s for an inventory row lock -> error (default is 50s)
performance_schema             = ON
skip-name-resolve
